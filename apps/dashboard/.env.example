# =====================================================================
# Portfolio Risk Dashboard - Environment Secrets (.env.example)
# Copy this file to .env and fill in your secrets:
#   cp .env.example .env
# =====================================================================

# 1. Database Secrets
# Non-sensitive parameters (host, port, user, database) are configured in config.yaml
DB_PASSWORD=your_db_password_here

# 2. Telegram Bot Secrets (Optional)
TELEGRAM_BOT_TOKEN=

# 3. Optional Streamlit Server Overrides (Default: 8501 on 0.0.0.0)
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
