# =====================================================================
# Portfolio Analytics Platform - Environment Configuration (.env.example)
# Copy this file to .env and configure for your chosen database backend:
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# 1. Environment Execution Mode (Optional, default: production)
# ---------------------------------------------------------------------
# Set to 'production', 'development', or 'test'.
# - production:  targets production database ('stocks')
# - development: automatically enforces and redirects to dev database ('stocks_dev')
# - test:        automatically isolates to 'stocks_dev' or on-demand SQLite (:memory:)
PORTFOLIO_ENV=production

# ---------------------------------------------------------------------
# 2. Database Backend Selection & Credentials
# Currently supported engines: 'mariadb' (or 'mysql') and 'sqlite'
# ---------------------------------------------------------------------

# === OPTION A: SQLite Database (Fastest & Simplest Local Setup) ===
# Zero server installation required. File and tables are created automatically.
#
# UNCOMMENT the two lines below to use SQLite:
# DB_TYPE=sqlite
# SQLITE_PATH=stocks.s3db
#
# IMPORTANT for SQLite:
# The following configs are NOT NEEDED and are ignored:
#   - DB_PASSWORD: NOT NEEDED
#   - DB_USER:     NOT NEEDED
#   - DB_HOST:     NOT NEEDED
#   - DB_PORT:     NOT NEEDED
#
# Note: SQLite database path must always use the '.s3db' extension (e.g. stocks.s3db)
# to ensure it is gitignored and properly routed during development/testing.

# === OPTION B: MariaDB / MySQL Database (Default for Networked & Production Setups) ===
# Requires a running MariaDB/MySQL instance.
# Tables are created automatically upon connection.
#
# Database secret password (REQUIRED when using MariaDB):
DB_PASSWORD=your_db_password_here

# Non-sensitive MariaDB connection parameters (defaults are defined in config.yaml,
# but can be overridden here via environment variables):
# DB_HOST=192.168.178.40
# DB_PORT=3306
# DB_USER=stocks
# DB_NAME=stocks
# DB_DATABASES=stocks

# ---------------------------------------------------------------------
# 3. Automated Telegram Bot Reporting (Optional)
# ---------------------------------------------------------------------
# Provide your Telegram Bot API token to enable automated PDF/chart reports.
# Can be left empty if automated Telegram reporting is disabled.
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------
# 4. Streamlit Server Overrides (Optional, defaults: 8501 on 0.0.0.0)
# ---------------------------------------------------------------------
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
